# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Default model for this repo. Override per-script if you want.
#   claude-opus-5     $5 / $25  per 1M tokens  (most capable, default)
#   claude-sonnet-5   $2 / $10  per 1M tokens  (good learning default)
#   claude-haiku-4-5  $1 / $5   per 1M tokens  (cheap, simple tasks)
AI_MODEL=claude-opus-5

# Effort: low | medium | high | xhigh | max. Lower = cheaper + faster.
AI_EFFORT=high

# Embeddings for the RAG phase. Get one at https://dash.voyageai.com
# Anthropic does not serve an embeddings endpoint; Voyage is the usual pairing.
VOYAGE_API_KEY=pa-...

# Hard ceiling in USD. aicore refuses to call the API once a run exceeds this.
AI_SPEND_LIMIT_USD=2.00
